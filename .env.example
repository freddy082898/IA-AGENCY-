# Copier en .env (jamais commité) et remplir.

# Bot DÉDIÉ aux validations (créé avec @BotFather). Utiliser un AUTRE bot que celui
# du plugin Telegram officiel (channels), sinon les deux se disputent les messages.
TELEGRAM_VALIDATION_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ton identifiant de chat Telegram (voir README : « Trouver mon chat id »).
# Seules les réponses venant de ce chat sont acceptées.
TELEGRAM_CHAT_ID=123456789

# Délai d'attente d'une validation déclenchée par le garde-fou (minutes, max 14).
GARDE_FOU_DELAI_MINUTES=14
